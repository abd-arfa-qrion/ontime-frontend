{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "http://localhost:3000"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,DELETE,PATCH,POST,PUT"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, cookie, Authorization"
        }
      ],
      "regex": "^/api(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "dynamicRoutes": [
    {
      "page": "/api/auth/[...nextauth]",
      "regex": "^/api/auth/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPnextauth": "nxtPnextauth"
      },
      "namedRegex": "^/api/auth/(?<nxtPnextauth>.+?)(?:/)?$"
    },
    {
      "page": "/api/[[...user]]",
      "regex": "^/api(?:/(.+?))?(?:/)?$",
      "routeKeys": {
        "nxtPuser": "nxtPuser"
      },
      "namedRegex": "^/api(?:/(?<nxtPuser>.+?))?(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/admin/absensi",
      "regex": "^/admin/absensi(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/absensi(?:/)?$"
    },
    {
      "page": "/admin/akademik",
      "regex": "^/admin/akademik(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/akademik(?:/)?$"
    },
    {
      "page": "/admin/justifikasi",
      "regex": "^/admin/justifikasi(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/justifikasi(?:/)?$"
    },
    {
      "page": "/admin/kelas",
      "regex": "^/admin/kelas(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/kelas(?:/)?$"
    },
    {
      "page": "/admin/laporan",
      "regex": "^/admin/laporan(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/laporan(?:/)?$"
    },
    {
      "page": "/admin/pengaturan",
      "regex": "^/admin/pengaturan(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/pengaturan(?:/)?$"
    },
    {
      "page": "/admin/pengumuman",
      "regex": "^/admin/pengumuman(?:/)?$",
      "routeKeys": {},
